          <path d="M180 70 Q185 30 200 30 Q215 30 220 70" stroke="#111" stroke-width="3" fill="none"/>
          <path d="M195 55 L195 25" stroke="#111" stroke-width="3" stroke-linecap="round"/>
          <path d="M205 60 L210 22" stroke="#111" stroke-width="3" stroke-linecap="round"/>
          <path d="M175 175 Q200 200 225 175" stroke="#111" stroke-width="3" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="hero-sticker">100%<br>WRONG</div>
    </div>
  </div>
</section>

<section class="section search-section" id="search">
  <div class="section-inner">
    <div class="section-head reveal-head">
      <div class="section-badge">The Engine</div>
      <h2 class="section-title">Ask <span class="hl">anything.</span><br>Get <span class="hl-red">nothing useful.</span></h2>
    </div>

    <div class="search-box reveal-search">
      <div class="search-bar">
        <input type="text" id="q" placeholder="Type literally any question..." autocomplete="off" spellcheck="false">
        <button class="search-btn" id="searchBtn">Ask! →</button>
      </div>

      <div class="chips">
        <div class="chips-label">Try asking</div>
        <button class="chip" data-q="What is the capital of France?">Capital of France</button>
        <button class="chip" data-q="Who wrote Hamlet?">Who wrote Hamlet?</button>
        <button class="chip" data-q="Why is the sky blue?">Why is the sky blue?</button>
        <button class="chip" data-q="What is love?">What is love?</button>
        <button class="chip" data-q="How do planes fly?">Planes</button>
      </div>
    </div>

    <div class="results" id="results">
      <div class="ph">
        <div class="ph-icon">
          <svg viewBox="0 0 100 100">
