      <circle cx="62" cy="42" r="4" fill="#111"/>
      <path d="M38 66 Q50 74 62 66" stroke="#111" stroke-width="3.5" fill="none" stroke-linecap="round"/>
    </svg>
  </div>
  <div class="loader-text">AntiSearch</div>
  <div class="loader-progress"><div class="loader-progress-fill"></div></div>
</div>

<nav id="nav">
  <div style="display:flex;align-items:center;gap:8px">
    <button class="icon-btn" onclick="toggleHistory()" title="History">📜</button>
    <a class="brand" onclick="window.scrollTo({top:0,behavior:'smooth'})">
      <div class="brand-face">
        <svg viewBox="0 0 100 100">
          <circle cx="50" cy="52" r="39" fill="#FFD93D" stroke="#111" stroke-width="3"/>
          <circle cx="38" cy="45" r="6" fill="#fff" stroke="#111" stroke-width="2"/>
          <circle cx="62" cy="45" r="6" fill="#fff" stroke="#111" stroke-width="2"/>
          <circle cx="38" cy="45" r="3" fill="#111"/>
          <circle cx="62" cy="45" r="3" fill="#111"/>
          <path d="M40 66 Q50 74 60 66" stroke="#111" stroke-width="3" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="brand-name">AntiSearch</span>
    </a>
  </div>
  <ul class="nav-links">
    <li><a onclick="scrollToId('search')">Search</a></li>
    <li><a onclick="scrollToId('crew')">The Crew</a></li>
    <li><a onclick="scrollToId('rules')">Rules</a></li>
  </ul>
  <div class="nav-right">
    <div class="live-counter"><span class="num" id="liveCount">1,247</span> <span>being lied to</span></div>
    <button class="icon-btn" onclick="toggleDark()" id="darkBtn">🌙</button>
    <button class="icon-btn" onclick="toggleSound()" id="soundBtn">🔊</button>
    <button class="nav-premium" onclick="openPremium()">
      <span class="badge-new">NEW</span> Premium
    </button>
    <button class="nav-signout" id="signoutBtn">Sign out</button>
  </div>
</nav>

<section class="hero">
  <div class="hero-band"></div>
  <div class="hero-inner">
    <div class="hero-left">
      <div class="hero-badge">Est. 2026 · Certified Useless</div>
      <h1 class="hero-title">
        Every Answer<br>Except <span class="mark">The</span><br><span class="warn">Right</span> One.
      </h1>
      <p class="hero-sub">
        Ask anything. We hand you <strong>completely unrelated facts</strong>, formatted like real search results. The correct answer was fetched, verified, and <strong>deleted</strong> before you could see it.
      </p>
      <div class="hero-actions">
        <button class="btn btn-primary" onclick="scrollToId('search')">Get lied to →</button>
        <button class="btn btn-ghost" onclick="openPremium()">Go Premium ★</button>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-char">
        <svg viewBox="0 0 400 500">
          <defs>
            <linearGradient id="bodyGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#FFE066"/>
              <stop offset="100%" stop-color="#FBC02D"/>
            </linearGradient>
          </defs>
          <ellipse cx="200" cy="470" rx="110" ry="16" fill="#111" opacity=".12"/>
          <rect x="150" y="360" width="30" height="90" rx="12" fill="#111"/>
          <rect x="220" y="360" width="30" height="90" rx="12" fill="#111"/>
          <ellipse cx="165" cy="455" rx="30" ry="14" fill="#111"/>
