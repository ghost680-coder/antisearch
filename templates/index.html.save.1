<script>
/* ============================================================
   SOUND SYSTEM — simple version
   ============================================================ */
let audioCtx = null;
let soundOn = localStorage.getItem('as_sound') !== 'off';

function beep(freq, dur, type='sine', vol=0.08){
  if (!soundOn) return;
  if (!audioCtx) {
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}
  }
  if (!audioCtx) return;
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const o = audioCtx.createOscillator();
  const g = audioCtx.createGain();
  o.type = type;
  o.frequency.value = freq;
  g.gain.setValueAtTime(vol, audioCtx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
  o.connect(g);
  g.connect(audioCtx.destination);
  o.start();
  o.stop(audioCtx.currentTime + dur);
}

const sfx = {
  click: () => beep(660, 0.06),
  pop: () => beep(880, 0.08, 'triangle'),
  whoosh: () => beep(300, 0.3),
  boing: () => beep(400, 0.4),
  squeak: () => beep(1800, 0.05, 'triangle'),
  chime: () => { beep(880, 0.1); setTimeout(() => beep(1320, 0.15), 80); },
  tada: () => { beep(523, 0.1); setTimeout(() => beep(659, 0.1), 100); setTimeout(() => beep(784, 0.3), 200); },
  laugh: () => { beep(700, 0.06); setTimeout(() => beep(900, 0.06), 80); setTimeout(() => beep(700, 0.06), 160); },
  laughEvil: () => { beep(400, 0.1); setTimeout(() => beep(500, 0.1), 120); setTimeout(() => beep(300, 0.3), 240); },
  cry: () => { beep(600, 0.3); setTimeout(() => beep(450, 0.4), 250); },
  fart: () => beep(90, 0.6, 'sawtooth', 0.12),
  burp: () => beep(120, 0.5, 'sawtooth', 0.1),
  cuckoo: () => { beep(880, 0.2); setTimeout(() => beep(660, 0.3), 250); },
  drumroll: () => { for (let i = 0; i < 15; i++) setTimeout(() => beep(200, 0.03, 'square', 0.05), i * 40); },
  sadTrombone: () => { beep(392, 0.15); setTimeout(() => beep(370, 0.15), 150); setTimeout(() => beep(349, 0.15), 300); setTimeout(() => beep(330, 0.6), 450); },
  error: () => beep(220, 0.3, 'sawtooth', 0.07),
};

function toggleSound(){
  soundOn = !soundOn;
  localStorage.setItem('as_sound', soundOn ? 'on' : 'off');
  document.getElementById('soundBtn').textContent = soundOn ? '🔊' : '🔇';
  toast(soundOn ? 'Sound on' : 'Sound off');
  if (soundOn) sfx.tada();
}

/* ============================================================
   DARK MODE
   ============================================================ */
function toggleDark(){
  document.body.classList.toggle('dark');
  const isDark = document.body.classList.contains('dark');
  localStorage.setItem('as_dark', isDark ? '1' : '0');
  document.getElementById('darkBtn').textContent = isDark ? '☀️' : '🌙';
  sfx.cuckoo();
}

/* ============================================================
   LIVE COUNTER
   ============================================================ */
let liveUsers = 1200 + Math.floor(Math.random() * 200);
setInterval(() => {
  liveUsers = Math.max(800, liveUsers + Math.floor(Math.random() * 7) - 3);
  document.getElementById('liveCount').textContent = liveUsers.toLocaleString();
}, 3000);

/* ============================================================
   HISTORY
   ============================================================ */
let history = [];
try { history = JSON.parse(localStorage.getItem('as_history') || '[]'); } catch(e) { history = []; }

function toggleHistory(){
  document.getElementById('historySidebar').classList.toggle('show');
  sfx.click();
  renderHistory();
}
function renderHistory(){
  const list = document.getElementById('historyList');
  list.innerHTML = '';
  if (!history.length){
    list.innerHTML = '<li class="history-empty">No searches yet.</li>';
    return;
  }
  history.slice(0, 20).forEach(h => {
    const li = document.createElement('li');
    li.className = 'history-item';
    li.innerHTML = `<span class="q">${escapeHtml(h.q)}</span>`;
    li.onclick = () => {
      document.getElementById('q').value = h.q;
      toggleHistory();
      runSearch();
    };
    list.appendChild(li);
  });
}
function addToHistory(q){
  history = history.filter(h => h.q !== q);
  history.unshift({ q, t: Date.now() });
  history = history.slice(0, 30);
  try { localStorage.setItem('as_history', JSON.stringify(history)); } catch(e) {}
  renderHistory();
}
function clearHistory(){
  history = [];
  localStorage.removeItem('as_history');
  renderHistory();
  sfx.error();
  toast('History cleared');
}

/* ============================================================
   CURSOR
   ============================================================ */
const cur = document.getElementById('cur');
const IS_TOUCH = ('ontouchstart' in window) || navigator.maxTouchPoints > 0 || window.innerWidth < 900;
let mouseX = window.innerWidth / 2, mouseY = window.innerHeight / 2;
let lastMouseX = mouseX, lastMouseY = mouseY;
let mouseVelX = 0, mouseVelY = 0;

if (!IS_TOUCH){
  document.addEventListener('mousemove', e => {
    mouseX = e.clientX; mouseY = e.clientY;
    mouseVelX = mouseX - lastMouseX;
    mouseVelY = mouseY - lastMouseY;
    lastMouseX = mouseX; lastMouseY = mouseY;
    cur.style.transform = `translate(${mouseX - 6}px, ${mouseY - 6}px)`;
  });
  document.addEventListener('mouseover', e => {
    if (e.target.closest('button,a,input,.res-card,.chip,.mascot-card,.rule'))
      cur.classList.add('hover');
    else cur.classList.remove('hover');
  });
}

/* ============================================================
   LOADER
   ============================================================ */
window.addEventListener('load', () => {
  setTimeout(() => document.getElementById('loader').classList.add('done'), 1400);
});

/* ============================================================
   NAV
   ============================================================ */
window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 30);
}, {passive: true});

function scrollToId(id){
  document.getElementById(id)?.scrollIntoView({behavior:'smooth',block:'start'});
}

/* ============================================================
   TOAST
   ============================================================ */
function toast(msg){
  const existing = document.querySelector('.toast');
  if (existing) existing.remove();
  const t = document.createElement('div');
  t.className = 'toast';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => {
    t.style.animation = 'toastOut .3s forwards';
    setTimeout(() => t.remove(), 300);
  }, 2400);
}

/* ============================================================
   SCROLL REVEALS
   ============================================================ */
const revealIO = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting){
      e.target.classList.add('in');
      revealIO.unobserve(e.target);
    }
  });
}, { threshold: 0.15 });
document.querySelectorAll('.reveal-head, .reveal-search, .reveal-card, .reveal-rule').forEach(el => revealIO.observe(el));

/* ============================================================
   RUNAWAY BUTTON
   ============================================================ */
const searchBtn = document.getElementById('searchBtn');
const BUTTON_LABELS = ['Ask!', 'Nope!', 'Catch me!', 'Miss!', 'Whoosh!', 'Not today!'];
let dodgeCount = 0;
const MAX_DODGES = 6;
let surrendered = false, currentlyDodging = false;

if (!IS_TOUCH){
  document.addEventListener('mousemove', (e) => {
    if (surrendered) return;
    const rect = searchBtn.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const dx = e.clientX - cx, dy = e.clientY - cy;
    const dist = Math.hypot(dx, dy);
    if (dist < 150){
      const angle = Math.atan2(dy, dx);
      const offsetX = -Math.cos(angle) * 100;
      const offsetY = -Math.sin(angle) * 70;
      searchBtn.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
      searchBtn.classList.add('dodging');
      if (!currentlyDodging){
        currentlyDodging = true;
        dodgeCount++;
        sfx.boing();
        if (dodgeCount < MAX_DODGES) searchBtn.textContent = BUTTON_LABELS[Math.min(dodgeCount, BUTTON_LABELS.length - 1)] + ' →';
        if (dodgeCount === 1) toast('The button is shy.');
        else if (dodgeCount === 3) toast('The button is faster than you.');
        if (dodgeCount >= MAX_DODGES){
          surrendered = true;
          searchBtn.classList.remove('dodging');
          searchBtn.classList.add('surrendered');
          searchBtn.textContent = 'Fine. →';
          searchBtn.style.transform = '';
          fireConfetti();
          sfx.tada();
          toast('The button surrenders.');
        }
      }
    } else if (dist > 240){
      currentlyDodging = false;
      if (!surrendered){
        searchBtn.style.transform = '';
        searchBtn.classList.remove('dodging');
      }
    }
  });
}

searchBtn.addEventListener('click', () => {
  if (!surrendered && !IS_TOUCH){
    dodgeCount++;
    if (dodgeCount >= MAX_DODGES){
      surrendered = true;
      searchBtn.classList.add('surrendered');
      searchBtn.textContent = 'Fine. →';
      searchBtn.style.transform = '';
      fireConfetti();
      sfx.tada();
    }
    return;
  }
  runSearch();
});

function fireConfetti(){
  const colors = ['#FFD93D', '#FBC02D', '#1E3A8A', '#EF4444', '#22C55E'];
  const btnRect = searchBtn.getBoundingClientRect();
  const originX = btnRect.left + btnRect.width / 2;
  const originY = btnRect.top + btnRect.height / 2;
  for (let i = 0; i < 30; i++){
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.background = colors[Math.floor(Math.random() * colors.length)];
    c.style.left = originX + 'px';
    c.style.top = originY + 'px';
    document.body.appendChild(c);
    const angle = Math.random() * Math.PI * 2;
    const force = 100 + Math.random() * 200;
    c.animate([
      {transform: 'translate(0,0)', opacity: 1},
      {transform: `translate(${Math.cos(angle) * force}px, ${Math.sin(angle) * force + 200}px) rotate(720deg)`, opacity: 0}
    ], {duration: 1500});
    setTimeout(() => c.remove(), 1600);
  }
}

/* ============================================================
   CHIPS + MASCOT INTERACTIONS
   ============================================================ */
document.querySelectorAll('.chip').forEach(chip => {
  chip.addEventListener('click', () => {
    sfx.pop();
    document.getElementById('q').value = chip.dataset.q;
    runSearch();
  });
});
document.querySelectorAll('.mascot-card').forEach(card => {
  card.addEventListener('mouseenter', () => { if (!IS_TOUCH) sfx.squeak(); });
  card.addEventListener('click', () => {
    sfx.laugh();
    toast("The mascot doesn't answer. It only hides.");
  });
});
document.addEventListener('click', (e) => {
  if (e.target.closest('.res-card')) sfx.squeak();
  if (e.target.closest('.history-item')) sfx.pop();
});

/* ============================================================
   RANDOM CHAOS — every 10-20 seconds
   ============================================================ */
const CHAOS = [
  { sfx: 'fart', msg: 'Wumbo farted. Rude.' },
  { sfx: 'burp', msg: 'Blip burped. No apology.' },
  { sfx: 'cuckoo', msg: 'Cuckoo! The clock is broken.' },
  { sfx: 'laugh', msg: 'The mascots are laughing at you.' },
];
setTimeout(function chaos(){
  if (Math.random() < 0.4){
    const event = CHAOS[Math.floor(Math.random() * CHAOS.length)];
    sfx[event.sfx]();
    document.body.classList.add('shaking');
    setTimeout(() => document.body.classList.remove('shaking'), 700);
    setTimeout(() => toast(event.msg), 200);
  }
  setTimeout(chaos, 10000 + Math.random() * 10000);
}, 12000);

/* ============================================================
   PREMIUM MODAL
   ============================================================ */
const premiumModal = document.getElementById('premiumModal');
function openPremium(){
  premiumModal.classList.add('show');
  document.body.style.overflow = 'hidden';
  sfx.laughEvil();
}
function closePremium(){
  premiumModal.classList.remove('show');
  document.body.style.overflow = '';
}
function fakePurchase(tier){
  const responses = [
    'Payment declined by the mascots.',
    'Your card was rejected. Probably wisely.',
    'Error: The payment processor has also been lied to.'
  ];
  sfx.sadTrombone();
  setTimeout(() => toast(responses[Math.floor(Math.random() * responses.length)]), 600);
  setTimeout(() => {
    closePremium();
    setTimeout(() => toast('Welcome to nothing.'), 400);
  }, 1800);
}

/* ============================================================
   LOGOUT REFUSAL
   ============================================================ */
const logoutModal = document.getElementById('logoutModal');
const logoutSubText = document.getElementById('logoutSubText');
const logoutRetryBtn = document.getElementById('logoutRetryBtn');
let logoutAttempts = 0;
const LOGOUT_MSGS = [
  'But you just got here. And we have so many <strong>wrong answers</strong> left to give you.',
  'Are you sure? We were just getting <strong>comfortable lying</strong> to each other.',
  "You can't leave. There is no \"leave.\" Only <strong>AntiSearch</strong>.",
  'The exit has been <strong>deleted</strong>. Like all our correct answers.',
  "FINE. Try again. See if we care.",
];

function attemptLogout(){
  logoutAttempts++;
  sfx.boing();
  if (logoutAttempts > 1){
    toast("Where do you think you're going?");
  }
  setTimeout(() => openLogout(), 400);
}
function openLogout(){
  logoutModal.classList.add('show');
  document.body.style.overflow = 'hidden';
  updateLogoutMessage();
  sfx.cry();
}
function updateLogoutMessage(){
  const idx = Math.min(logoutAttempts - 1, LOGOUT_MSGS.length - 1);
  logoutSubText.innerHTML = LOGOUT_MSGS[idx];
  logoutRetryBtn.textContent = logoutAttempts > 3 ? 'Give up' : 'Try again';
}
function closeLogout(){
  logoutModal.classList.remove('show');
  document.body.style.overflow = '';
}
logoutRetryBtn.addEventListener('click', () => {
  logoutAttempts++;
  sfx.laugh();
  toast("There's no 'out.' Only 'in.'");
  updateLogoutMessage();
});

const signoutBtn = document.getElementById('signoutBtn');
signoutBtn.addEventListener('click', (e) => {
  e.preventDefault();
  attemptLogout();
});

/* ============================================================
   SEARCH
   ============================================================ */
const qInput = document.getElementById('q');
const results = document.getElementById('results');
let hiddenTotal = parseInt(localStorage.getItem('as_hidden') || '0');
document.getElementById('hiddenCount').textContent = hiddenTotal;

function escapeHtml(s){
  return String(s || '').replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
}

async function runSearch(){
  const q = qInput.value.trim();
  if (!q){ sfx.error(); toast('Type something first!'); qInput.focus(); return; }

  sfx.whoosh();
  sfx.drumroll();
  addToHistory(q);

  results.innerHTML = `
    <div class="loading-phase">
      <div class="phase-dots"><span></span><span></span><span></span></div>
      <div class="phase-text" id="phaseText">Connecting...</div>
    </div>
  `;
  const phaseText = document.getElementById('phaseText');

  try {
    const response = await fetch(`/api/search/stream?q=${encodeURIComponent(q)}`);
    if (!response.ok) throw new Error('bad response');

    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    while (true){
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const events = buffer.split('\n\n');
      buffer = events.pop();

      for (const chunk of events){
        const lines = chunk.split('\n');
        let evType = 'message', evData = '';
        for (const line of lines){
          if (line.startsWith('event: ')) evType = line.slice(7);
          if (line.startsWith('data: ')) evData = line.slice(6);
        }
        if (!evData) continue;
        const payload = JSON.parse(evData);

        if (evType === 'phase'){
          phaseText.textContent = payload.text;
          if (payload.text.includes('Deleting')) sfx.chime();
        }
        if (evType === 'result'){
          setTimeout(() => {
            renderResults(payload);
            sfx.tada();
          }, 300);
        }
      }
    }
  } catch (err){
    console.error(err);
    results.innerHTML = `
      <div class="ph">
        <strong>The mascots went on strike.</strong>
        <span>We can't reach the server. It's hiding from you too.</span>
      </div>
    `;
    sfx.error();
  }
}

function renderResults(data){
  results.innerHTML = '';

  const banner = document.createElement('div');
  banner.className = 'res-banner';
  banner.innerHTML = `
    <div class="banner-mark">✕</div>
    <div>
      <div class="banner-title">0 correct · ${data.count} wrong</div>
      <div class="banner-sub">${escapeHtml(data.message || 'The correct answer was deleted.')}</div>
    </div>
  `;
  results.appendChild(banner);

  const meta = document.createElement('div');
  meta.className = 'res-meta';
  meta.innerHTML = `<span>"${escapeHtml(data.query)}"</span><span class="meta-right">${data.count} wrong answers</span>`;
  results.appendChild(meta);

  const ul = document.createElement('ul');
  ul.className = 'res-list';
  (data.wrong || []).forEach((r, i) => {
    const li = document.createElement('li');
    li.className = 'res-card';
    li.style.animationDelay = (i * 0.08) + 's';
    const num = String(i + 1).padStart(2, '0');
    li.innerHTML = `
      <div class="res-num">${num}</div>
      <div class="res-title">${escapeHtml(r.title)}</div>
      <div class="res-snippet">${escapeHtml(r.snippet)}</div>
    `;
    li.addEventListener('click', () => toast('Still wrong!'));
    ul.appendChild(li);
  });
  results.appendChild(ul);

  const foot = document.createElement('div');
  foot.className = 'res-footnote';
  foot.textContent = 'The correct answer is sealed · nothing related to it will appear';
  results.appendChild(foot);

  hiddenTotal++;
  localStorage.setItem('as_hidden', hiddenTotal);
  document.getElementById('hiddenCount').textContent = hiddenTotal;
}

