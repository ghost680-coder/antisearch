          <rect x="145" y="230" width="18" height="60" fill="#1E3A8A"/>
          <rect x="237" y="230" width="18" height="60" fill="#1E3A8A"/>
          <path d="M120 130 Q120 240 135 300 L265 300 Q280 240 280 130 Q280 60 200 60 Q120 60 120 130 Z" fill="url(#bodyGrad)" stroke="#111" stroke-width="3"/>
          <path d="M120 170 Q80 200 80 260" stroke="#111" stroke-width="3" fill="url(#bodyGrad)"/>
          <path d="M280 170 Q320 200 320 260" stroke="#111" stroke-width="3" fill="url(#bodyGrad)"/>
          <circle cx="80" cy="265" r="20" fill="#111"/>
          <circle cx="320" cy="265" r="20" fill="#111"/>
          <rect x="105" y="118" width="190" height="12" fill="#111"/>
          <circle cx="160" cy="125" r="42" fill="#111"/>
          <circle cx="240" cy="125" r="42" fill="#111"/>
          <circle cx="160" cy="125" r="35" fill="#DDD"/>
          <circle cx="240" cy="125" r="35" fill="#DDD"/>
          <circle cx="160" cy="125" r="28" fill="#fff"/>
          <circle cx="240" cy="125" r="28" fill="#fff"/>
          <circle cx="168" cy="128" r="12" fill="#7A4F1E"/>
          <circle cx="248" cy="128" r="12" fill="#7A4F1E"/>
          <circle cx="168" cy="128" r="6" fill="#111"/>
