<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#FFD93D">
<title>AntiSearch — Ask Anything. Get Nothing.</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23FFD93D'/%3E%3Ccircle cx='35' cy='42' r='8' fill='%23fff'/%3E%3Ccircle cx='65' cy='42' r='8' fill='%23fff'/%3E%3Cpath d='M35 68 Q50 78 65 68' stroke='%23111' stroke-width='4' fill='none' stroke-linecap='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Fredoka:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}

:root{
  --yellow:#FFD93D;--yellow-deep:#FBC02D;--yellow-light:#FFE680;
  --cream:#FFFDF7;--white:#FFFFFF;--ink:#111111;--ink-soft:#3a3a3a;--ink-dim:rgba(17,17,17,.5);
  --navy:#1E3A8A;--red:#EF4444;--green:#22C55E;
  --bounce:cubic-bezier(0.34,1.56,0.64,1);--out:cubic-bezier(0.16,1,0.3,1);
  --display:'Anton',sans-serif;--round:'Fredoka',sans-serif;--sans:'Inter',sans-serif;--mono:'JetBrains Mono',monospace;
  --pad:clamp(16px,4vw,40px);
}

body.dark{--cream:#0a0a0a;--white:#141414;--ink:#FFD93D;--ink-soft:#f5e9b8;--ink-dim:rgba(255,217,61,.5)}
body.dark{background:#0a0a0a;color:#FFD93D}
body.dark nav.scrolled{background:rgba(10,10,10,.94)}
body.dark .hero-band{background:#1a1a1a}
body.dark .mascots-section{background:#050505}
body.dark footer{background:#000}

html{scroll-behavior:smooth}
body{font-family:var(--sans);background:var(--cream);color:var(--ink);overflow-x:hidden;-webkit-font-smoothing:antialiased;min-height:100vh;transition:background .5s ease,color .5s ease}
input,textarea,select,button{font-size:16px}
::selection{background:var(--ink);color:var(--yellow)}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:var(--cream)}
::-webkit-scrollbar-thumb{background:var(--ink);border-radius:10px}
svg{max-width:100%;height:auto;display:block}

@keyframes screenShake{0%,100%{transform:translate(0,0)}20%{transform:translate(-4px,2px) rotate(-.3deg)}40%{transform:translate(5px,-2px) rotate(.3deg)}60%{transform:translate(-3px,-1px)}80%{transform:translate(3px,1px)}}
body.shaking{animation:screenShake .6s ease-in-out}

.cur{position:fixed;top:0;left:0;width:12px;height:12px;background:var(--ink);border-radius:50%;pointer-events:none;z-index:9999;transition:width .25s,height .25s;will-change:transform}
.cur.hover{width:40px;height:40px;background:var(--yellow-deep)}
@media (hover:none),(max-width:900px){.cur{display:none!important}}

#loader{position:fixed;inset:0;z-index:10000;background:var(--yellow);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;transition:opacity .7s,visibility .7s;padding:var(--pad)}
#loader.done{opacity:0;visibility:hidden}
.loader-face{width:90px;height:90px;animation:bounceLoader 1.1s var(--bounce) infinite}
@keyframes bounceLoader{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-20px) rotate(3deg)}}
.loader-text{font-family:var(--display);font-size:1.2rem;letter-spacing:.35em;text-transform:uppercase;color:var(--ink)}
.loader-progress{width:180px;height:4px;background:rgba(17,17,17,.15);border-radius:10px;overflow:hidden}
.loader-progress-fill{height:100%;width:0;background:var(--ink);animation:fillProgress 1.4s forwards}
@keyframes fillProgress{to{width:100%}}

nav{position:fixed;top:0;left:0;right:0;z-index:800;display:flex;align-items:center;justify-content:space-between;padding:20px var(--pad);transition:all .4s;border-bottom:2px solid transparent;gap:12px}
nav.scrolled{padding:12px var(--pad);background:rgba(255,217,61,.92);backdrop-filter:blur(16px);border-bottom-color:var(--ink)}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);cursor:pointer;transition:transform .3s var(--bounce)}
.brand:hover{transform:scale(1.05) rotate(-2deg)}
.brand-face{width:32px;height:32px}
.brand-name{font-family:var(--display);font-size:1.25rem;letter-spacing:.02em;text-transform:uppercase}
.nav-links{display:flex;gap:30px;list-style:none;position:absolute;left:50%;transform:translateX(-50%)}
.nav-links a{color:var(--ink);text-decoration:none;font-family:var(--round);font-size:.9rem;font-weight:600;cursor:pointer;transition:transform .2s}
.nav-links a:hover{transform:translateY(-2px)}
.nav-right{display:flex;gap:10px;align-items:center}
.live-counter{display:flex;align-items:center;gap:6px;padding:6px 12px;border-radius:100px;background:rgba(17,17,17,.08);font-family:var(--mono);font-size:.68rem;font-weight:700;color:var(--ink);border:2px solid var(--ink);white-space:nowrap}
.live-counter::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 1.6s infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(1.2)}}
.icon-btn{width:38px;height:38px;border-radius:50%;background:var(--white);border:2px solid var(--ink);color:var(--ink);font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .25s var(--bounce);box-shadow:2px 2px 0 rgba(17,17,17,.9)}
.icon-btn:hover{transform:translate(-2px,-2px);box-shadow:4px 4px 0 rgba(17,17,17,.9);background:var(--yellow-light)}
.nav-premium{padding:10px 18px;border-radius:100px;background:var(--yellow-deep);color:var(--ink);border:2px solid var(--ink);font-family:var(--round);font-size:.82rem;font-weight:700;cursor:pointer;box-shadow:3px 3px 0 rgba(17,17,17,.9);display:flex;align-items:center;gap:6px;position:relative;white-space:nowrap}
.nav-premium::before{content:'★'}
.nav-premium:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 rgba(17,17,17,.9)}
.nav-premium .badge-new{position:absolute;top:-8px;right:-8px;padding:2px 7px;border-radius:100px;background:var(--red);color:var(--white);font-family:var(--mono);font-size:.55rem;font-weight:700;border:2px solid var(--ink);transform:rotate(8deg)}
.nav-signout{font-family:var(--round);font-size:.82rem;font-weight:600;color:var(--ink-soft);cursor:pointer;padding:8px 12px;border-radius:100px;background:transparent;border:2px solid transparent;white-space:nowrap}
.nav-signout:hover{background:rgba(17,17,17,.06);color:var(--ink)}

.history-sidebar{position:fixed;top:0;bottom:0;left:0;z-index:750;width:min(300px,80vw);background:var(--cream);border-right:3px solid var(--ink);transform:translateX(-100%);transition:transform .4s var(--out);padding:24px;overflow-y:auto}
.history-sidebar.show{transform:translateX(0)}
.history-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding-bottom:16px;border-bottom:2px solid var(--ink)}
.history-head h3{font-family:var(--display);font-size:1.1rem;text-transform:uppercase}
.history-close{background:transparent;border:none;font-size:1.3rem;cursor:pointer;color:var(--ink);width:32px;height:32px;border-radius:50%}
.history-close:hover{background:rgba(17,17,17,.08);transform:rotate(90deg)}
.history-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.history-item{padding:12px;border-radius:10px;background:var(--white);border:2px solid var(--ink);font-family:var(--round);font-size:.85rem;font-weight:500;cursor:pointer;box-shadow:2px 2px 0 rgba(17,17,17,.9);display:flex;justify-content:space-between;gap:8px}
.history-item:hover{transform:translate(-2px,-2px);box-shadow:4px 4px 0 rgba(17,17,17,.9);background:var(--yellow-light)}
.history-item .q{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.history-empty{text-align:center;padding:40px 20px;font-family:var(--round);color:var(--ink-dim)}
.history-clear{width:100%;margin-top:20px;padding:10px;border-radius:100px;background:transparent;border:2px solid var(--ink);font-family:var(--round);font-size:.78rem;font-weight:600;cursor:pointer}
.history-clear:hover{background:rgba(239,68,68,.1);color:var(--red);border-color:var(--red)}

.hero{position:relative;min-height:100vh;padding:140px var(--pad) 80px;display:flex;align-items:center;overflow:hidden}
.hero-band{position:absolute;left:-8%;right:-8%;top:30%;height:42%;background:var(--yellow);transform:rotate(-2.5deg)}
.hero-inner{position:relative;z-index:5;max-width:1300px;width:100%;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.hero-left{animation:fadeUp 1s .2s forwards;opacity:0}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.hero-badge{display:inline-flex;align-items:center;gap:10px;padding:8px 18px;background:var(--ink);color:var(--yellow);border-radius:100px;font-family:var(--round);font-size:.72rem;font-weight:700;text-transform:uppercase;margin-bottom:24px;transform:rotate(-2deg)}
.hero-badge::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--yellow);animation:pulse 1.4s infinite}
.hero-title{font-family:var(--display);font-size:clamp(2.2rem,7.5vw,6rem);line-height:.9;letter-spacing:-.01em;text-transform:uppercase;color:var(--ink);margin-bottom:20px}
.hero-title .mark{color:var(--navy)}
.hero-title .warn{color:var(--red)}
.hero-sub{font-family:var(--round);font-size:1.1rem;font-weight:500;line-height:1.65;color:var(--ink-soft);max-width:500px;margin-bottom:32px}
.hero-sub strong{color:var(--ink);background:linear-gradient(180deg,transparent 62%,var(--yellow-light) 62%);padding:0 3px}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:10px;padding:15px 28px;border-radius:100px;font-family:var(--round);font-size:.9rem;font-weight:700;cursor:pointer;text-transform:uppercase;border:3px solid var(--ink);transition:transform .25s var(--bounce),box-shadow .25s;min-height:44px;text-decoration:none}
.btn-primary{background:var(--ink);color:var(--yellow);box-shadow:5px 5px 0 rgba(17,17,17,.9)}
.btn-primary:hover{transform:translate(-3px,-3px);box-shadow:8px 8px 0 rgba(17,17,17,.9)}
.btn-ghost{background:var(--white);color:var(--ink);box-shadow:5px 5px 0 rgba(17,17,17,.2)}
.btn-ghost:hover{transform:translate(-3px,-3px);box-shadow:8px 8px 0 rgba(17,17,17,.2)}
.hero-right{position:relative;height:min(520px,60vh);animation:fadeUp 1.2s .5s forwards;opacity:0}
.hero-char{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.hero-char svg{height:100%;width:auto;max-width:100%;filter:drop-shadow(0 20px 40px rgba(17,17,17,.15));animation:float 4s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-16px) rotate(1deg)}}
.hero-sticker{position:absolute;top:16px;right:16px;padding:12px 18px;background:var(--white);border:3px solid var(--ink);border-radius:12px;font-family:var(--round);font-size:.85rem;font-weight:700;transform:rotate(6deg);box-shadow:4px 4px 0 rgba(17,17,17,.9);text-align:center;line-height:1.15}
.hero-sticker::after{content:'';position:absolute;bottom:-10px;left:24px;width:16px;height:16px;background:var(--white);border-right:3px solid var(--ink);border-bottom:3px solid var(--ink);transform:rotate(45deg)}

.section{position:relative;padding:100px var(--pad);overflow:hidden}
.section-inner{max-width:1200px;margin:0 auto;position:relative;z-index:2}
.section-head{text-align:center;margin-bottom:56px;opacity:0;transform:translateY(30px);transition:all .9s}
.section-head.in{opacity:1;transform:translateY(0)}
.section-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border:2.5px solid var(--ink);border-radius:100px;font-family:var(--mono);font-size:.68rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;background:var(--white);margin-bottom:20px}
.section-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--red)}
.section-title{font-family:var(--display);font-size:clamp(1.8rem,5vw,3.8rem);line-height:1;text-transform:uppercase;color:var(--ink)}
.section-title .hl{color:var(--navy)}
.section-title .hl-red{color:var(--red)}

.search-section{background:var(--cream)}
.search-box{position:relative;max-width:820px;margin:0 auto;opacity:0;transform:translateY(30px);transition:all .8s}
.search-box.in{opacity:1;transform:translateY(0)}
.search-bar{display:flex;background:var(--white);border:4px solid var(--ink);border-radius:100px;padding:6px 6px 6px 26px;box-shadow:8px 8px 0 rgba(17,17,17,.9);transition:transform .3s}
.search-bar:focus-within{transform:translate(-2px,-2px);box-shadow:12px 12px 0 rgba(17,17,17,.9)}
.search-bar input{flex:1;min-width:0;background:transparent;border:none;outline:none;font-family:var(--round);font-size:16px;font-weight:500;color:var(--ink);padding:16px 0}
.search-bar input::placeholder{color:rgba(17,17,17,.35)}
.search-btn{flex-shrink:0;padding:16px 30px;border-radius:100px;background:var(--ink);color:var(--yellow);border:3px solid var(--ink);font-family:var(--round);font-size:.9rem;font-weight:700;text-transform:uppercase;cursor:pointer;min-height:44px;position:relative;will-change:transform;transition:transform .4s var(--bounce),background .3s}
.search-btn.dodging{background:var(--red)}
.search-btn.surrendered{background:var(--green)}

.chips{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:24px}
.chips-label{width:100%;font-family:var(--mono);font-size:.68rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--ink-dim);text-align:center;margin-bottom:4px}
.chip{padding:9px 18px;border-radius:100px;background:var(--white);border:2.5px solid var(--ink);font-family:var(--round);font-size:.82rem;font-weight:600;cursor:pointer;box-shadow:3px 3px 0 rgba(17,17,17,.85);display:flex;align-items:center;gap:8px;transition:transform .3s var(--bounce)}
.chip::before{content:'?';color:var(--red);font-weight:700}
.chip:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 rgba(17,17,17,.85);background:var(--yellow-light)}

.results{max-width:820px;margin:48px auto 0;min-height:200px}
.ph{padding:60px 30px;background:var(--white);border:3px dashed var(--ink);border-radius:24px;text-align:center}
.ph-icon{width:60px;height:60px;margin:0 auto 20px;animation:float 5s infinite}
.ph strong{display:block;font-family:var(--display);font-size:1.3rem;text-transform:uppercase;color:var(--ink);margin-bottom:8px}
.ph span{font-family:var(--round);color:var(--ink-soft)}

.loading-phase{padding:60px 30px;text-align:center}
.phase-dots{display:flex;justify-content:center;gap:10px;margin-bottom:24px}
.phase-dots span{width:18px;height:18px;border-radius:50%;background:var(--yellow-deep);border:3px solid var(--ink);animation:phaseBounce 1.1s infinite}
.phase-dots span:nth-child(2){animation-delay:.12s;background:var(--navy)}
.phase-dots span:nth-child(3){animation-delay:.24s;background:var(--red)}
@keyframes phaseBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.phase-text{font-family:var(--display);font-size:1.1rem;text-transform:uppercase;color:var(--ink);transition:opacity .3s}

.res-banner{display:flex;gap:18px;padding:20px 24px;background:var(--white);border:3px solid var(--ink);border-left:8px solid var(--red);border-radius:16px;margin-bottom:24px;box-shadow:6px 6px 0 rgba(17,17,17,.15);animation:bannerIn .6s var(--bounce)}
@keyframes bannerIn{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}
.banner-mark{width:48px;height:48px;flex-shrink:0;border-radius:50%;background:var(--red);color:var(--white);border:3px solid var(--ink);display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:1.35rem;animation:markShake 2.5s infinite}
@keyframes markShake{0%,100%{transform:rotate(0)}25%{transform:rotate(-8deg)}75%{transform:rotate(8deg)}}
.banner-title{font-family:var(--display);font-size:1.1rem;text-transform:uppercase;color:var(--ink);margin-bottom:3px}
.banner-sub{font-family:var(--round);font-size:.88rem;font-weight:500;color:var(--ink-soft)}

.res-meta{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:14px 20px;background:var(--ink);color:var(--cream);border-radius:100px;margin-bottom:22px;font-family:var(--round);font-size:.82rem;font-weight:600}
.meta-right{color:var(--red);font-weight:700}
.meta-right::before{content:'✕ '}

.res-list{list-style:none;display:flex;flex-direction:column;gap:14px}
.res-card{position:relative;padding:22px 22px 22px 88px;background:var(--white);border:3px solid var(--ink);border-radius:18px;cursor:pointer;box-shadow:5px 5px 0 rgba(17,17,17,.9);opacity:0;transform:translateY(20px);animation:cardIn .5s forwards;transition:transform .25s var(--bounce)}
@keyframes cardIn{to{opacity:1;transform:translateY(0)}}
.res-card:hover{transform:translate(-3px,-3px);box-shadow:9px 9px 0 rgba(17,17,17,.9);background:var(--yellow-light)}
.res-num{position:absolute;left:20px;top:20px;width:52px;height:52px;border-radius:50%;background:var(--red);color:var(--white);border:3px solid var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:var(--display);font-size:1.1rem;line-height:1}
.res-num::after{content:'WRONG';font-family:var(--mono);font-size:.4rem;font-weight:700;margin-top:2px}
.res-title{font-family:var(--round);font-size:1.1rem;font-weight:700;color:var(--ink);line-height:1.3;margin-bottom:6px;padding-right:44px}
.res-snippet{font-size:.92rem;line-height:1.6;color:var(--ink-soft)}

.share-btn{position:absolute;top:18px;right:18px;width:34px;height:34px;border-radius:50%;background:var(--cream);border:2px solid var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .25s var(--bounce)}
.share-btn:hover{transform:scale(1.15) rotate(-8deg);background:var(--yellow)}
.share-btn svg{width:14px;height:14px;stroke:var(--ink);fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}

.res-footnote{margin-top:24px;padding:18px 24px;border:3px dashed var(--ink);border-radius:18px;text-align:center;font-family:var(--round);font-size:.88rem;font-weight:600;color:var(--ink);background:var(--yellow-light)}

.mascots-section{background:var(--ink);padding:100px var(--pad)}
.mascots-section .section-badge{background:transparent;border-color:var(--yellow);color:var(--yellow)}
.mascots-section .section-badge::before{background:var(--yellow)}
.mascots-section .section-title{color:var(--cream)}
.mascots-section .section-title .hl{color:var(--yellow)}
.mascots-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}
.mascot-card{position:relative;padding:28px 24px;background:var(--cream);border-radius:24px;opacity:0;transform:translateY(30px);transition:all .9s;cursor:pointer}
.mascot-card.in{opacity:1;transform:translateY(0)}
.mascot-card:hover{transform:translateY(-8px) scale(1.02);background:var(--yellow-light)}
.mascot-eyebrow{font-family:var(--round);font-size:1.05rem;font-weight:700;color:var(--yellow-deep);display:block;margin-bottom:4px}
.mascot-name{font-family:var(--display);font-size:clamp(1.6rem,3.5vw,2.8rem);text-transform:uppercase;color:var(--ink);margin-bottom:16px}
.mascot-name .dot{color:var(--red)}
.mascot-art{height:200px;margin-bottom:16px;display:flex;align-items:center;justify-content:center}
.mascot-art svg{height:100%;width:auto;animation:float 4.5s ease-in-out infinite}
.mascot-bio{font-family:var(--round);font-size:.9rem;font-weight:500;line-height:1.6;color:var(--ink-soft);margin-bottom:16px}
.mascot-bio strong{color:var(--ink);background:linear-gradient(180deg,transparent 62%,var(--yellow-light) 62%);padding:0 2px}
.mascot-tag{display:inline-flex;align-items:center;gap:8px;padding:7px 13px;background:var(--ink);color:var(--yellow);border-radius:100px;font-family:var(--mono);font-size:.6rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
.mascot-tag::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--red)}
.mascot-speech{position:absolute;top:14px;right:14px;padding:10px 14px;background:var(--ink);color:var(--yellow);border-radius:14px;font-family:var(--round);font-size:.78rem;font-weight:600;max-width:160px;line-height:1.35;transform:rotate(4deg);pointer-events:none;opacity:.9}

.manifesto-section{background:var(--cream);padding:100px var(--pad)}
.manifesto-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;max-width:900px;margin:48px auto 0}
.rule{padding:28px 24px;background:var(--white);border:3px solid var(--ink);border-radius:20px;opacity:0;transform:translateY(30px);transition:all .8s;box-shadow:4px 4px 0 rgba(17,17,17,.9)}
.rule.in{opacity:1;transform:translateY(0)}
.rule:hover{transform:translateY(-6px);box-shadow:8px 8px 0 var(--yellow);background:var(--yellow-light)}
.rule-num{display:inline-block;padding:5px 12px;background:var(--ink);color:var(--yellow);border-radius:100px;font-family:var(--mono);font-size:.65rem;font-weight:700;margin-bottom:14px}
.rule-text{font-family:var(--round);font-size:1rem;font-weight:500;line-height:1.5;color:var(--ink)}
.rule-text .punch{font-weight:700;background:linear-gradient(180deg,transparent 58%,var(--yellow) 58%);padding:0 2px}

footer{background:var(--ink);color:var(--cream);padding:60px var(--pad) 30px;position:relative}
footer::before{content:'';position:absolute;top:0;left:0;right:0;height:8px;background:repeating-linear-gradient(90deg,var(--yellow) 0 16px,var(--ink) 16px 32px)}
.foot-inner{max-width:1200px;margin:0 auto}
.foot-top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px;padding-bottom:40px;border-bottom:1.5px dashed rgba(255,253,247,.15);margin-bottom:24px}
.foot-brand{display:flex;align-items:center;gap:12px;margin-bottom:16px;cursor:pointer}
.foot-brand svg{width:32px;height:32px}
.foot-brand-name{font-family:var(--display);font-size:1.2rem;text-transform:uppercase;color:var(--yellow)}
.foot-brand-block p{font-family:var(--round);font-size:.9rem;font-weight:500;line-height:1.65;color:rgba(255,253,247,.7);max-width:320px}
.foot-col h5{font-family:var(--mono);font-size:.65rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--yellow);margin-bottom:16px}
.foot-col ul{list-style:none;display:flex;flex-direction:column;gap:10px}
.foot-col a{color:rgba(255,253,247,.75);text-decoration:none;font-family:var(--round);font-size:.9rem;font-weight:500;cursor:pointer}
.foot-col a:hover{color:var(--yellow)}
.foot-bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;font-family:var(--mono);font-size:.65rem;color:rgba(255,253,247,.5);text-transform:uppercase}
.foot-counter .num{color:var(--yellow);font-weight:700;font-size:1rem}

.toast{position:fixed;bottom:24px;right:24px;z-index:9600;padding:14px 20px;background:var(--yellow);color:var(--ink);border:3px solid var(--ink);border-radius:100px;font-family:var(--round);font-size:.85rem;font-weight:700;box-shadow:5px 5px 0 rgba(17,17,17,.9);display:flex;align-items:center;gap:10px;max-width:calc(100vw - 32px);animation:toastIn .5s var(--bounce)}
.toast::before{content:'!';width:22px;height:22px;background:var(--ink);color:var(--yellow);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:.85rem;flex-shrink:0}
@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes toastOut{to{opacity:0;transform:translateY(20px)}}

.confetti{position:fixed;width:10px;height:10px;pointer-events:none;z-index:9500;border-radius:2px}

.modal-overlay{position:fixed;inset:0;z-index:9700;background:rgba(17,17,17,.75);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;visibility:hidden;transition:opacity .4s,visibility .4s;overflow-y:auto}
.modal-overlay.show{opacity:1;visibility:visible}
.modal{width:100%;max-width:1000px;background:var(--cream);border:4px solid var(--ink);border-radius:28px;padding:40px;box-shadow:12px 12px 0 var(--ink);transform:translateY(40px) scale(.95);opacity:0;transition:transform .55s var(--bounce),opacity .4s;max-height:calc(100vh - 32px);overflow-y:auto;margin:auto;position:relative}
.modal-overlay.show .modal{transform:translateY(0) scale(1);opacity:1}
.modal-close{position:sticky;top:0;float:right;width:44px;height:44px;border-radius:50%;background:var(--cream);border:3px solid var(--ink);font-size:1.3rem;font-weight:700;cursor:pointer;margin:-8px -8px 0 0;z-index:5}
.modal-close:hover{transform:rotate(90deg);background:var(--yellow)}
.modal-head{text-align:center;margin-bottom:32px;clear:both}
.modal-badge{display:inline-block;padding:8px 18px;background:var(--ink);color:var(--yellow);border-radius:100px;font-family:var(--mono);font-size:.68rem;font-weight:700;text-transform:uppercase;margin-bottom:16px;transform:rotate(-2deg)}
.modal-badge::before{content:'★ '}
.modal-title{font-family:var(--display);font-size:clamp(1.6rem,4vw,3rem);text-transform:uppercase;color:var(--ink);margin-bottom:12px}
.modal-title .red{color:var(--red)}
.modal-sub{font-family:var(--round);font-size:1rem;color:var(--ink-soft);max-width:520px;margin:0 auto;line-height:1.6}
.modal-sub strong{color:var(--ink);background:linear-gradient(180deg,transparent 62%,var(--yellow-light) 62%);padding:0 3px}
.tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:28px}
.tier{padding:28px 22px;background:var(--white);border:3px solid var(--ink);border-radius:22px;display:flex;flex-direction:column;box-shadow:5px 5px 0 rgba(17,17,17,.15);transition:transform .3s var(--bounce)}
.tier:hover{transform:translateY(-6px);box-shadow:9px 9px 0 rgba(17,17,17,.15)}
.tier.featured{background:var(--yellow-light);transform:rotate(1deg);box-shadow:5px 5px 0 var(--ink)}
.tier.featured:hover{transform:translateY(-6px);box-shadow:9px 9px 0 var(--ink)}
.tier-tag{position:absolute;top:-14px;left:50%;transform:translateX(-50%) rotate(-3deg);padding:5px 14px;background:var(--red);color:var(--white);border:3px solid var(--ink);border-radius:100px;font-family:var(--mono);font-size:.55rem;font-weight:700;text-transform:uppercase;position:relative}
.tier-icon{font-size:2rem;margin-bottom:12px;line-height:1}
.tier-name{font-family:var(--display);font-size:1.4rem;text-transform:uppercase;color:var(--ink);margin-bottom:4px}
.tier-tagline{font-family:var(--round);font-size:.82rem;font-style:italic;color:var(--ink-soft);margin-bottom:16px;min-height:2.4em}
.tier-price{font-family:var(--display);font-size:2.4rem;line-height:1;color:var(--ink);margin-bottom:4px}
.tier-price span{font-size:.9rem;color:var(--ink-soft)}
.tier-per{font-family:var(--mono);font-size:.6rem;font-weight:700;text-transform:uppercase;color:var(--ink-dim);margin-bottom:20px}
.tier-features{list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:22px;flex:1}
.tier-features li{font-family:var(--round);font-size:.82rem;line-height:1.5;color:var(--ink-soft);display:flex;gap:10px}
.tier-features li::before{content:'✗';flex-shrink:0;font-weight:700;color:var(--red)}
.tier-features li.yes::before{content:'✓';color:var(--green)}
.tier-btn{width:100%;padding:12px;border-radius:100px;background:var(--ink);color:var(--yellow);border:3px solid var(--ink);font-family:var(--round);font-size:.82rem;font-weight:700;text-transform:uppercase;cursor:pointer;min-height:44px;box-shadow:3px 3px 0 rgba(17,17,17,.9)}
.tier.featured .tier-btn{background:var(--red);color:var(--white)}
.modal-note{text-align:center;font-family:var(--mono);font-size:.65rem;color:var(--ink-dim);text-transform:uppercase;line-height:1.7}
.modal-note strong{color:var(--ink)}

.logout-modal{width:100%;max-width:480px;background:var(--cream);border:4px solid var(--ink);border-radius:24px;padding:36px 28px;box-shadow:10px 10px 0 var(--ink);transform:translateY(40px) scale(.95);opacity:0;transition:transform .55s var(--bounce),opacity .4s;text-align:center;margin:auto;position:relative}
.modal-overlay.show .logout-modal{transform:translateY(0) scale(1);opacity:1}
.logout-face{width:90px;height:90px;margin:0 auto 20px;animation:float 3s ease-in-out infinite}
.logout-title{font-family:var(--display);font-size:2rem;text-transform:uppercase;color:var(--ink);margin-bottom:12px}
.logout-title .red{color:var(--red)}
.logout-sub{font-family:var(--round);font-size:.95rem;line-height:1.6;color:var(--ink-soft);margin-bottom:24px}
.logout-sub strong{color:var(--ink)}
.logout-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.logout-btn{padding:12px 22px;border-radius:100px;border:3px solid var(--ink);font-family:var(--round);font-size:.85rem;font-weight:700;text-transform:uppercase;cursor:pointer;box-shadow:3px 3px 0 rgba(17,17,17,.9);min-height:44px}
.logout-btn.stay{background:var(--ink);color:var(--yellow)}
.logout-btn.try-again{background:var(--cream);color:var(--ink)}

@media (max-width:900px){
  .nav-links{display:none}
  .live-counter{display:none}
  .hero-inner{grid-template-columns:1fr;gap:20px}
  .hero-right{height:min(360px,45vh);order:-1}
  .hero-left{text-align:center}
  .hero-sub{margin:0 auto 32px}
  .hero-actions{justify-content:center}
  .mascots-grid{grid-template-columns:1fr;max-width:420px;margin-left:auto;margin-right:auto}
  .manifesto-grid{grid-template-columns:1fr;max-width:500px}
  .tiers{grid-template-columns:1fr;max-width:420px;margin-left:auto;margin-right:auto}
  .tier.featured{transform:rotate(0)}
  .foot-top{grid-template-columns:1fr;gap:30px}
  .toast{left:16px;right:16px;bottom:16px}
  .search-bar{flex-direction:column;gap:10px;padding:12px;border-radius:22px}
  .search-bar input{text-align:center;padding:12px 6px}
  .search-btn{width:100%;justify-content:center}
  .res-card{padding:18px 16px 18px 76px}
  .res-num{left:14px;top:16px;width:44px;height:44px;font-size:1rem}
  .chips{overflow-x:auto;flex-wrap:nowrap;justify-content:flex-start;padding-bottom:6px;scrollbar-width:none}
  .chips::-webkit-scrollbar{display:none}
  .chip{flex-shrink:0}
}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>

<div class="cur" id="cur"></div>

<div class="history-sidebar" id="historySidebar">
  <div class="history-head">
    <h3>Recent lies</h3>
    <button class="history-close" onclick="toggleHistory()">✕</button>
  </div>
  <ul class="history-list" id="historyList"></ul>
  <button class="history-clear" onclick="clearHistory()">Clear history</button>
</div>

<div id="loader">
  <div class="loader-face">
    <svg viewBox="0 0 100 100">
      <circle cx="50" cy="52" r="42" fill="#111"/>
      <circle cx="50" cy="52" r="39" fill="#FFD93D"/>
      <circle cx="38" cy="42" r="8" fill="#fff" stroke="#111" stroke-width="2.5"/>
      <circle cx="62" cy="42" r="8" fill="#fff" stroke="#111" stroke-width="2.5"/>
