<script>
/* ===== MINION SOUNDS ===== */
(function(){
  // Get reference to the existing audio context
  function minionBeep(freq, dur, type){
    try {
      // Reuse existing beep function if it exists
      if (typeof beep === 'function'){
        beep(freq, dur, type || 'sine', 0.1);
        return;
      }
      // Otherwise create our own
      if (!window._minionAudio){
        window._minionAudio = new (window.AudioContext || window.webkitAudioContext)();
      }
      const ctx = window._minionAudio;
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = type || 'sine';
      o.frequency.value = freq;
      g.gain.setValueAtTime(0.1, ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
      o.connect(g);
      g.connect(ctx.destination);
      o.start();
      o.stop(ctx.currentTime + dur);
    } catch(e){}
  }

  const minionSfx = {
    hello: function(){
      minionBeep(880, 0.08);
      setTimeout(function(){ minionBeep(1100, 0.08); }, 90);
      setTimeout(function(){ minionBeep(700, 0.15); }, 180);
    },
    banana: function(){
      minionBeep(600, 0.1);
      setTimeout(function(){ minionBeep(900, 0.08); }, 100);
      setTimeout(function(){ minionBeep(750, 0.08); }, 180);
      setTimeout(function(){ minionBeep(1000, 0.2); }, 260);
    },
    giggle: function(){
      for (let i = 0; i < 6; i++){
        setTimeout(function(){
          minionBeep(1000 + Math.random() * 400, 0.05, 'triangle');
        }, i * 70);
      }
    },
    poopaye: function(){
      minionBeep(500, 0.12);
      setTimeout(function(){ minionBeep(800, 0.1); }, 120);
      setTimeout(function(){ minionBeep(600, 0.1); }, 220);
      setTimeout(function(){ minionBeep(900, 0.25); }, 320);
    },
    cheer: function(){
      for (let i = 0; i < 8; i++){
        setTimeout(function(){
          minionBeep(800 + Math.random() * 800, 0.06, 'triangle');
        }, i * 60);
      }
    },
    sad: function(){
      minionBeep(600, 0.2);
      setTimeout(function(){ minionBeep(500, 0.2); }, 200);
      setTimeout(function(){ minionBeep(400, 0.4); }, 400);
    }
  };

  // Attach to window so you can test
  window.minionSfx = minionSfx;

  // Auto-wire to elements
  document.addEventListener('DOMContentLoaded', function(){
    // Chips → banana
    document.querySelectorAll('.chip').forEach(function(c){
      c.addEventListener('click', minionSfx.banana);
    });
    // Mascot cards → hello
    document.querySelectorAll('.mascot-card').forEach(function(c){
      c.addEventListener('click', function(){
        const arr = ['hello', 'banana', 'poopaye', 'giggle'];
        minionSfx[arr[Math.floor(Math.random() * arr.length)]]();
      });
    });
    // Search button → cheer
    const sb = document.getElementById('searchBtn');
    if (sb) sb.addEventListener('click', minionSfx.cheer);
    // Sign out → sad
    const so = document.getElementById('signoutBtn');
    if (so) so.addEventListener('click', minionSfx.sad);
    // Premium buy → poopaye
    document.querySelectorAll('.tier-btn').forEach(function(b){
      b.addEventListener('click', minionSfx.poopaye);
    });
    console.log('🍌 Minion sounds loaded. Test with: minionSfx.hello()');
  });
})();
</script> 
<script>
/* ============================================================
   3 NEW FEATURES
   2. Typewriter effect on phase text
   7. Mascot follows cursor across the page
   15. Mascots argue with each other
   ============================================================ */

/* ---------- 2. TYPEWRITER EFFECT ---------- */
(function(){
/* ---------- 7. MASCOT FOLLOWS CURSOR ---------- */
(function(){
  if ('ontouchstart' in window || window.innerWidth < 900) return;

  var walker = document.createElement('div');
  walker.id = 'pageWalker';
  walker.innerHTML = '<svg viewBox="0 0 100 130" width="70" height="91">' +
    '<ellipse cx="50" cy="120" rx="30" ry="6" fill="#000" opacity=".15"/>' +
    '<rect x="28" y="15" width="44" height="75" rx="18" fill="#FFD93D" stroke="#111" stroke-width="3"/>' +
    '<circle cx="42" cy="42" r="10" fill="#fff" stroke="#111" stroke-width="2"/>' +
    '<circle cx="58" cy="42" r="10" fill="#fff" stroke="#111" stroke-width="2"/>' +
    '<circle cx="42" cy="44" r="4" fill="#111"/>' +
    '<circle cx="58" cy="44" r="4" fill="#111"/>' +
    '<path d="M38 68 Q50 76 62 68" stroke="#111" stroke-width="2.5" fill="none" stroke-linecap="round"/>' +
    '<rect x="34" y="85" width="14" height="28" rx="4" fill="#111"/>' +
    '<rect x="52" y="85" width="14" height="28" rx="4" fill="#111"/>' +
    '</svg>';
  walker.style.cssText = 'position:fixed;width:70px;height:91px;z-index:9997;pointer-events:none;' +
    'filter:drop-shadow(0 6px 16px rgba(0,0,0,.15));transition:transform .6s cubic-bezier(0.16,1,0.3,1);' +
    'will-change:left,top;';
  document.body.appendChild(walker);

  var posX = window.innerWidth - 100;
  var posY = window.innerHeight - 150;
  var mouseX = posX;
  var mouseY = posY;
  var facing = 1;

  document.addEventListener('mousemove', function(e){
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  walker.style.left = posX + 'px';
  walker.style.top = posY + 'px';

  setInterval(function(){
    var targetX = mouseX + 90;
    var targetY = mouseY + 60;
    var dx = targetX - posX;
    var dy = targetY - posY;
    var dist = Math.hypot(dx, dy);
    if (dist < 30) return;

    posX += dx * 0.06;
    posY += dy * 0.06;
    posX = Math.max(10, Math.min(window.innerWidth - 80, posX));
    posY = Math.max(10, Math.min(window.innerHeight - 100, posY));

    if (Math.abs(dx) > 5) facing = dx < 0 ? -1 : 1;

    walker.style.left = posX + 'px';
    walker.style.top = posY + 'px';
    walker.style.transform = 'scaleX(' + facing + ')';
  }, 80);
})();

/* ---------- 15. MASCOTS ARGUE ---------- */
(function(){
  var ARGUMENTS = [
    { from: 'wumbo', text: "Blip knows nothing." },
    { from: 'blip',  text: "That's not what Teddy says!" },
    { from: 'zonk',  text: "Wumbo is a coward." },
    { from: 'wumbo', text: "Zonk deleted MY answer." },
    { from: 'blip',  text: "I'm telling Jim." },
    { from: 'zonk',  text: "Blip eats all the bananas." },
    { from: 'wumbo', text: "Shut up, Blip." },
    { from: 'blip',  text: "You shut up!" },
    { from: 'zonk',  text: "Both of you are useless." },
    { from: 'wumbo', text: "I'm not talking to Zonk." },
    { from: 'blip',  text: "Teddy says you're wrong." },
    { from: 'zonk',  text: "Fight me, Wumbo." }
  ];

  function setBubble(bubble, text){
    bubble.classList.add('swap');
    setTimeout(function(){
      bubble.textContent = text;
      bubble.classList.remove('swap');
    }, 380);
  }

  function fireArgument(){
    var arg = ARGUMENTS[Math.floor(Math.random() * ARGUMENTS.length)];
    var bubble = document.querySelector('.mascot-speech[data-speech="' + arg.from + '"]');
    if (!bubble){
      var all = document.querySelectorAll('.mascot-speech');
      if (!all.length) return;
      bubble = all[Math.floor(Math.random() * all.length)];
    }
    setBubble(bubble, arg.text);
    document.body.classList.add('shaking');
    setTimeout(function(){ document.body.classList.remove('shaking'); }, 300);
  }

    // Fire on every search
  var searchBtn = document.getElementById('searchBtn');
  if (searchBtn){
    searchBtn.addEventListener('click', function(){
      setTimeout(fireArgument, 300);
      setTimeout(fireArgument, 1200);
    });
  }

  // Fire on every chip click
  document.querySelectorAll('.chip').forEach(function(c){
    c.addEventListener('click', function(){
      setTimeout(fireArgument, 400);
    });
  });

  // Fire every 4 seconds in the background
  setInterval(fireArgument, 4000);

  // Fire on every mascot card click
  document.querySelectorAll('.mascot-card').forEach(function(c){
    c.addEventListener('click', function(){
      setTimeout(fireArgument, 200);
      setTimeout(fireArgument, 900);
    });
  });

  // Fire on every result card click
  document.addEventListener('click', function(e){
    if (e.target.closest('.res-card')){
      setTimeout(fireArgument, 200);
    }
  });
})();

