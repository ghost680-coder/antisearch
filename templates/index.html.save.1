        <strong>Ready when you are!</strong>
        <span>Type a question above. Good luck catching the button.</span>
      </div>
    </div>
  </div>
</section>

<section class="section mascots-section" id="crew">
  <div class="section-inner">
    <div class="section-head reveal-head">
      <div class="section-badge">The Crew</div>
      <h2 class="section-title">Meet the <span class="hl">answer-hiders.</span></h2>
    </div>
    <div class="mascots-grid">
      <div class="mascot-card reveal-card">
        <div class="mascot-speech">I know the answer. Not telling.</div>
        <span class="mascot-eyebrow">Meet</span>
        <h3 class="mascot-name">Wumbo<span class="dot">.</span></h3>
        <div class="mascot-art">
          <svg viewBox="0 0 400 500">
            <path d="M140 240 Q140 380 155 400 L245 400 Q260 380 260 240 Z" fill="#1E3A8A"/>
            <path d="M120 130 Q120 250 135 300 L265 300 Q280 250 280 130 Q280 60 200 60 Q120 60 120 130 Z" fill="#FFD93D" stroke="#111" stroke-width="3"/>
            <circle cx="80" cy="262" r="18" fill="#111"/>
            <circle cx="320" cy="262" r="18" fill="#111"/>
            <circle cx="160" cy="122" r="38" fill="#111"/>
            <circle cx="240" cy="122" r="38" fill="#111"/>
            <circle cx="160" cy="122" r="26" fill="#fff"/>
            <circle cx="240" cy="122" r="26" fill="#fff"/>
            <circle cx="168" cy="126" r="10" fill="#7A4F1E"/>
            <circle cx="248" cy="126" r="10" fill="#7A4F1E"/>
            <path d="M195 55 L195 20" stroke="#111" stroke-width="3" stroke-linecap="round"/>
            <path d="M200 60 L210 18" stroke="#111" stroke-width="3" stroke-linecap="round"/>
            <path d="M178 178 Q200 195 222 178" stroke="#111" stroke-width="3" fill="none" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="mascot-bio">Tall, goggle-eyed, and <strong>professionally secretive</strong>. Wumbo writes wrong facts on cardboard signs and forgets correct answers on purpose.</p>
        <span class="mascot-tag">Answer Concealer</span>
      </div>

      <div class="mascot-card reveal-card">
        <div class="mascot-speech">Teddy knows! Ask Teddy!</div>
        <span class="mascot-eyebrow">Meet</span>
        <h3 class="mascot-name">Blip<span class="dot">.</span></h3>
        <div class="mascot-art">
          <svg viewBox="0 0 400 500">
            <path d="M150 260 Q150 380 165 400 L235 400 Q250 380 250 260 Z" fill="#1E3A8A"/>
            <path d="M130 180 Q130 290 145 320 L255 320 Q270 290 270 180 Q270 100 200 100 Q130 100 130 180 Z" fill="#FFD93D" stroke="#111" stroke-width="3"/>
            <circle cx="95" cy="282" r="16" fill="#111"/>
            <circle cx="305" cy="282" r="16" fill="#111"/>
            <circle cx="160" cy="160" r="34" fill="#111"/>
            <circle cx="240" cy="160" r="34" fill="#111"/>
            <circle cx="160" cy="160" r="22" fill="#fff"/>
            <circle cx="240" cy="160" r="22" fill="#fff"/>
            <circle cx="168" cy="164" r="9" fill="#7A4F1E"/>
            <circle cx="248" cy="164" r="9" fill="#7A4F1E"/>
            <path d="M185 225 Q200 240 215 225" stroke="#111" stroke-width="3" fill="none" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="mascot-bio">Short, round, permanently smiling. Blip specializes in <strong>cheerful misinformation</strong> and consults a teddy bear named Jim.</p>
        <span class="mascot-tag">Chief of Nonsense</span>
      </div>

      <div class="mascot-card reveal-card">
        <div class="mascot-speech">I deleted 47 truths today!</div>
        <span class="mascot-eyebrow">Meet</span>
        <h3 class="mascot-name">Zonk<span class="dot">.</span></h3>
        <div class="mascot-art">
          <svg viewBox="0 0 400 500">
            <path d="M140 250 Q140 380 158 400 L242 400 Q260 380 260 250 Z" fill="#1E3A8A"/>
            <path d="M120 130 Q120 250 135 300 L265 300 Q280 250 280 130 Q280 60 200 60 Q120 60 120 130 Z" fill="#FFD93D" stroke="#111" stroke-width="3"/>
            <circle cx="80" cy="262" r="18" fill="#111"/>
            <circle cx="320" cy="262" r="18" fill="#111"/>
            <circle cx="200" cy="125" r="55" fill="#111"/>
            <circle cx="200" cy="125" r="40" fill="#fff"/>
            <circle cx="200" cy="130" r="18" fill="#7A4F1E"/>
            <circle cx="200" cy="130" r="9" fill="#111"/>
            <circle cx="195" cy="124" r="4" fill="#fff"/>
            <path d="M175 180 Q200 205 225 180" stroke="#111" stroke-width="3" fill="none" stroke-linecap="round"/>
          </svg>
        </div>
